# =============================================================================
# Apartment Society Manager - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the actual '.env' file containing secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Application Settings
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/society_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# Docker / Container Database Variables
DB_HOST=postgres
DB_PORT=5432
DB_NAME=society_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# JWT secret key MUST be a secure base64-encoded string (minimum 256 bits / 32 bytes)
# Example generation command: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# -----------------------------------------------------------------------------
# CORS & File Storage Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Frontend Application Settings
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
