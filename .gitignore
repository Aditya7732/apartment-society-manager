# =============================================================================
# Git Ignore Configuration - Apartment Society Manager
# =============================================================================

# Environment & Secret Files
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.example
*.pem
*.key
*.p12
*.jks

# Java / Maven Build Artifacts (Backend)
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Uploads & Temporary Media Storage
backend/uploads/*
!backend/uploads/.gitkeep
uploads/

# Node.js & Frontend Build Outputs (Frontend)
frontend/node_modules/
node_modules/
frontend/dist/
dist/
build/
.eslintcache
*.tsbuildinfo

# Test Coverage & Tooling
coverage/
.nyc_output/
*.lcov
test-output/

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

# IDEs & Editor Configuration
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Docker & Container Volumes
.docker/
